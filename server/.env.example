# Copy to .env and fill in your values

# PostgreSQL (Cloud SQL or local)
DATABASE_URL=postgresql://user:password@localhost:5432/allcounty

# Tracerfy skip tracing (primary — email + phone for property owners)
TRACERFY_API_KEY=

# Apollo.io (optional — B2B/LLC enrichment)
APOLLO_API_KEY=

# RentCast (rental vacancy/days on market signals — weekly)
RENTCAST_API_KEY=

# Claude AI (email generation)
ANTHROPIC_API_KEY=

# Lob.com direct mail
LOB_API_KEY=

# SendGrid email outreach
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=outreach@allcountyboulder.com

# Alerts — Email SMTP (supports Gmail or Outlook/M365)
ALERT_EMAIL_TO=juan@roaksystems.com,leif@roaksystems.com
ALERT_SMTP_USER=alerts@roaksystems.com
ALERT_SMTP_PASSWORD=
# Alerts — Slack (optional)
ALERT_SLACK_WEBHOOK=

# Pipeline settings
TOP_LEADS_COUNT=50
