# Copy to .env and fill in your values

# PostgreSQL (Cloud SQL or local)
DATABASE_URL=postgresql://user:password@localhost:5432/allcounty

# Tracerfy skip tracing (primary — email + phone for property owners)
TRACERFY_API_KEY=

# Apollo.io (optional — B2B/LLC enrichment)
APOLLO_API_KEY=

# Claude AI (email generation)
ANTHROPIC_API_KEY=

# Lob.com direct mail
LOB_API_KEY=

# SendGrid email outreach
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=outreach@allcountyboulder.com

# Alerts — Gmail SMTP (create an App Password at myaccount.google.com/apppasswords)
ALERT_EMAIL_TO=you@gmail.com
ALERT_GMAIL_USER=yourbot@gmail.com
ALERT_GMAIL_APP_PASSWORD=
# Alerts — Slack (optional)
ALERT_SLACK_WEBHOOK=

# Pipeline settings
TOP_LEADS_COUNT=50
